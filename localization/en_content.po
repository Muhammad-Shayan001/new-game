msgid "ITEM_ARCHIVE_CARD_NAME"
msgstr "Archive Card"

msgid "ITEM_ARCHIVE_CARD_DESC"
msgstr "A blank index card. It opens the way to the Forgotten Quarter."

msgid "ITEM_LUGGAGE_TAG_NAME"
msgstr "Luggage Tag"

msgid "ITEM_LUGGAGE_TAG_DESC"
msgstr "A tag from lost luggage. Someone wrote a name, then scratched it out."

msgid "PZL_CH1_CLOCK_4_17_TITLE"
msgstr "The Stopped Clock"

msgid "PZL_CH1_CLOCK_4_17_HINT_1"
msgstr "Every clock in this city agrees on one moment."

msgid "PZL_CH1_CLOCK_4_17_HINT_2"
msgstr "The moment is written on the receipts and on the station clock."

msgid "PZL_CH1_CLOCK_4_17_HINT_3"
msgstr "Press 4, then 1, then 7."

msgid "DLG_CH1_M03_CATALOGUE_ARV_001"
msgstr "Item: one visitor. Condition: awake. This is... unusual."

msgid "DLG_CH1_M03_CATALOGUE_ALX_001"
msgstr "Where am I? Who are you?"

msgid "DLG_CH1_M03_CATALOGUE_ARV_002"
msgstr "Echo City. And I am merely the one who keeps the records."

msgid "DLG_CH1_M03_CATALOGUE_ALX_002"
msgstr "Then you have mine."

msgid "DLG_CH1_M03_CATALOGUE_ARV_003"
msgstr "Item: your name. Condition: misplaced. I am sorry."

msgid "DLG_CH1_M03_CATALOGUE_ALX_003"
msgstr "That's not an answer."

msgid "DLG_CH1_M03_CATALOGUE_ARV_004"
msgstr "It is the only one I am permitted to give. We... I am permitted to give."

msgid "DLG_CH1_M03_CATALOGUE_ALX_004"
msgstr "\"We\"?"

msgid "DLG_CH1_M03_CATALOGUE_ARV_005"
msgstr "A slip. Please record it as a slip."

msgid "DLG_CH1_M03_CATALOGUE_ARV_006"
msgstr "Take this card. Find what was removed."

msgid "DLG_CH2_M02_CAFE_MAY_001"
msgstr "Alex? Alex, look at me. It's me."

msgid "DLG_CH2_M02_CAFE_ALX_001"
msgstr "I don't... remember you."

msgid "DLG_CH2_M02_CAFE_MAY_002"
msgstr "That's okay. Vitals first. You're breathing, you're upright. We'll do the rest."

msgid "DLG_CH2_M02_CAFE_MAY_003"
msgstr "I'm not from here, Alex. This city is making me fuzzy at the edges."

msgid "DLG_CH2_M02_CAFE_ALX_CHOICE"
msgstr "(Ask Maya)"

msgid "DLG_CH2_M02_CAFE_MAY_004"
msgstr "Because I'm the one who never left. Don't go through that door alone."

msgid "DLG_CH2_M02_CAFE_CHOICE_WHY"
msgstr "Then why are you here?"

msgid "DLG_CH2_M02_CAFE_CHOICE_REAL"
msgstr "How do I know you're real?"

msgid "MISSION_CH1_M03_OBJ_TALK"
msgstr "Speak with the Archivist"

msgid "MISSION_CH1_S01_OBJ_TAGS"
msgstr "Find the lost luggage tags"

msgid "MISSION_CH1_S02_OBJ_CLOCK"
msgstr "Solve the stopped clock"

msgid "MISSION_CH2_M02_OBJ_TALK"
msgstr "Talk to Maya"

msgid "INFO_ARV_KEEPS_RECORDS_TEXT"
msgstr "The Archivist keeps the records of Echo City. He says he is only permitted to give some answers."

msgid "INFO_ARV_SLIP_WE_TEXT"
msgstr "The Archivist said \"we\", then asked for it to be recorded as a slip."

msgid "INFO_MAY_NOT_FROM_HERE_TEXT"
msgstr "Maya says she is not from Echo City. The city makes her fuzzy at the edges."

msgid "INFO_ARC_TAPE_LOADER_TEXT"
msgstr "A figure loaded three reels into the machine in a fixed order. Someone built this gallery on purpose."

msgid "HINT_ABILITY_MEMORY_SIGHT"
msgstr "Reveals hidden memories, writing and clues for a few seconds."

msgid "HINT_ABILITY_REALITY_SHIFT"
msgstr "Stand on a Shift Anchor to swap that area between two states."

msgid "HINT_ABILITY_TIME_ECHO"
msgstr "At an Echo Site watch a past event. In a record zone record a ghost copy of yourself."

msgid "HINT_ABILITY_ECHO_VOICE"
msgstr "Not available yet."

msgid "SHF_CH3_ANCHOR_BRIDGE_TITLE"
msgstr "The Anchor Fields gap"

msgid "DED_STUCK_AT_417_TITLE"
msgstr "The clocks stopped at the same moment"

msgid "ECH_CH3_TAPE_LOADING_TITLE"
msgstr "The Reel Loader"

msgid "ECH_CH3_TAPE_LOADING_CAP_1"
msgstr "The figure loads the CIRCLE reel. (click)"

msgid "ECH_CH3_TAPE_LOADING_CAP_2"
msgstr "Then the SQUARE reel. (click)"

msgid "ECH_CH3_TAPE_LOADING_CAP_3"
msgstr "Last, the TRIANGLE reel. (click)"

msgid "ECH_CH3_TAPE_LOADING_CAP_4"
msgstr "The figure leaves. The machine hums."

msgid "PZL_CH1_CLOCK_DEDUCTION_TITLE"
msgstr "What the Clocks Agree On"

msgid "PZL_CH1_CLOCK_DEDUCTION_HINT_1"
msgstr "Two things you found say the same thing. One is on a wall you can only read with Memory Sight."

msgid "PZL_CH1_CLOCK_DEDUCTION_HINT_2"
msgstr "Examine the station clock in Echo Station, then find the hidden writing in the clock room."

msgid "PZL_CH1_CLOCK_DEDUCTION_HINT_3"
msgstr "Use the clue board in the clock room. It links the station clock and the wall writing."

msgid "PZL_CH3_ANCHOR_BRIDGE_TITLE"
msgstr "The Missing Bridge"

msgid "PZL_CH3_ANCHOR_BRIDGE_HINT_1"
msgstr "There is no way across in this state. Try the anchor where you start."

msgid "PZL_CH3_ANCHOR_BRIDGE_HINT_2"
msgstr "On the Other Side a bridge exists, and a sigil only that side can show."

msgid "PZL_CH3_ANCHOR_BRIDGE_HINT_3"
msgstr "Shift at the first anchor, cross, read the sigil, shift back at the second anchor, then open the exit."

msgid "PZL_CH3_TAPE_ORDER_TITLE"
msgstr "The Reel Order"

msgid "PZL_CH3_TAPE_ORDER_HINT_1"
msgstr "Watch the echo again. The order matters."

msgid "PZL_CH3_TAPE_ORDER_HINT_2"
msgstr "Three reels: circle, square, triangle. Watch which goes in first."

msgid "PZL_CH3_TAPE_ORDER_HINT_3"
msgstr "Place CIRCLE in slot 1, SQUARE in slot 2, TRIANGLE in slot 3."

msgid "PZL_CH3_ECHO_PLATES_TITLE"
msgstr "Two Plates, One Person"

msgid "PZL_CH3_ECHO_PLATES_HINT_1"
msgstr "Both plates must be pressed at the same time."

msgid "PZL_CH3_ECHO_PLATES_HINT_2"
msgstr "You cannot stand on both. Record yourself with Time Echo."

msgid "PZL_CH3_ECHO_PLATES_HINT_3"
msgstr "Record yourself walking onto plate A, stop, then stand on plate B while your echo holds plate A."

msgid "MISSION_CH1_S02_OBJ_DEDUCE"
msgstr "Link what the wall and the station clock tell you"

msgid "MISSION_CH1_S02_OBJ_DIAL"
msgstr "Set the dial"

msgid "MISSION_CH1_S02_OBJ_TRACE"
msgstr "Find the clockmaker's note (optional)"

msgid "MISSION_CH3_M02_OBJ_SHIFT"
msgstr "Use Reality Shift at the first anchor"

msgid "MISSION_CH3_M02_OBJ_BRIDGE"
msgstr "Cross to the far platform and open the exit"

msgid "MISSION_CH3_S01_OBJ_ECHO"
msgstr "Watch the echo of the reel loader"

msgid "MISSION_CH3_S01_OBJ_TAPES"
msgstr "Put the memories in order"

msgid "MISSION_CH3_S01_OBJ_PLATES"
msgstr "Hold both plates with an echo"
