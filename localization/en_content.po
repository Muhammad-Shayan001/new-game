msgid "CHR_MAY_NAME"
msgstr "Maya Reed"

msgid "CHR_ARV_NAME"
msgstr "The Archivist"

msgid "CHR_ARC_NAME"
msgstr "The Architect"

msgid "CHR_FCH_NAME"
msgstr "The Forgotten Child"

