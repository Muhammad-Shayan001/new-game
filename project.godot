; Engine configuration file for AFTERLIFE.EXE (Godot 4.x)
config_version=5

[application]
config/name="AFTERLIFE.EXE"
config/version="0.2.0"
run/main_scene="res://scenes/game_root.tscn"
config/features=PackedStringArray("4.3", "Mobile")

[autoload]
EventBus="*res://scripts/autoload/event_bus.gd"
DataRegistry="*res://scripts/autoload/data_registry.gd"
GameState="*res://scripts/autoload/game_state.gd"
StoryState="*res://scripts/story/story_state.gd"
InputService="*res://scripts/autoload/input_service.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"
InventoryManager="*res://scripts/systems/inventory_manager.gd"
MemoryManager="*res://scripts/systems/memory_manager.gd"
AbilityManager="*res://scripts/abilities/ability_manager.gd"
PuzzleManager="*res://scripts/puzzles/puzzle_manager.gd"
ShiftManager="*res://scripts/abilities/shift_manager.gd"
TimeEchoManager="*res://scripts/echo/time_echo_manager.gd"
EchoDetection="*res://scripts/abilities/echo_detection.gd"
ProgressionManager="*res://scripts/systems/progression_manager.gd"
ObjectiveManager="*res://scripts/missions/objective_manager.gd"
DialogueManager="*res://scripts/dialogue/dialogue_manager.gd"
MissionManager="*res://scripts/missions/mission_manager.gd"
NetworkManager="*res://scripts/autoload/network_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[internationalization]
locale/fallback="en"
locale/translations=PackedStringArray("res://localization/en_ui.po", "res://localization/en_world.po", "res://localization/en_content.po")

[layer_names]
3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="interactable"
3d_physics/layer_4="echo_ghost"

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
